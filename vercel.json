{
  "buildCommand": "npm run build:vercel",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/crawl-sources",
      "schedule": "0 2 * * 1"
    },
    {
      "path": "/api/cron/weekly-personal-digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/daily-tip",
      "schedule": "0 7 * * 1-4"
    },
    {
      "path": "/api/cron/onboarding-status",
      "schedule": "0 7 * * 4"
    },
    {
      "path": "/api/cron/birthday-alert",
